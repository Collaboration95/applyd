# Publication boundary: deny every path, then allow audited generic code only.
# Do not force-add files. Expand this allowlist only for audited generic code.
# Private profiles, resumes (including filenames), applications, sources, exports,
# local instructions (AGENTS.md), screenshots, credentials and temporary files stay untracked.
/*
!/.gitignore
!/README.md
!/CONTRIBUTING.md
!/LICENSE
!/master-plan.md
!/scripts/
/scripts/*
!/scripts/workspace.py
!/scripts/resolve_resume.py
!/scripts/export_dashboard.py
!/scripts/import_pdf.py
!/scripts/workspace_config.py
!/scripts/check_publication.py
!/tests/
/tests/*
!/tests/test_workflow.py
!/tests/test_dashboard.py
!/tests/test_workspace_config.py
!/tests/test_publication.py
!/tests/run-grouping.test.cjs
!/docs/
/docs/*
!/docs/privacy.md
!/docs/brand/
/docs/brand/*
!/docs/brand/NOTES.md
!/docs/brand/build.py
!/docs/brand/preview.html
!/docs/brand/banner.svg
!/docs/brand/banner.png
!/docs/brand/social-preview.svg
!/docs/brand/social-preview.png
!/docs/brand/sprite.svg
!/docs/brand/sprite-64.png
!/docs/brand/sprite-128.png
!/docs/brand/sprite-256.png
!/docs/brand/spritesheet.svg
!/docs/brand/spritesheet-512x128.png
!/roadmap/

# Dashboard code only; data.js and data/ are generated from private records.
!/dashboard/
/dashboard/*
!/dashboard/index.html
!/dashboard/app.js
!/dashboard/runs.js
!/dashboard/style.css
!/dashboard/README.md

# Templates only; every real application record stays private.
!/applications/
/applications/*
!/applications/job-input.example.json
!/applications/TEMPLATE.md

__pycache__/
*.pyc
.DS_Store

# Audited filesystem identity index and synthetic lookup checks.
!/scripts/seen_index.py
!/scripts/seen.sh
!/tests/test_seen.py

# Generic run policy schema, portable settings helpers and synthetic checks.
!/settings.example.json
!/scripts/settings.py
!/tests/test_settings.py
!/tests/test_settings_integration.py
!/docs/settings.md

# Synthetic crash-window and single-browser-writer checks.
!/tests/test_submit_intent.py
